{
  "name": "dsh-dynamic-toolbox",
  "version": "0.5.1",
  "description": "工具箱（DSH 原生静态工具箱）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./remote": "./lib/remote.js",
    "./feature/jira": "./lib/features/jira.js",
    "./feature/git": "./lib/features/git.js",
    "./feature/files": "./lib/features/files.js",
    "./feature/flow": "./lib/features/flow.js",
    "./feature/flowedit": "./lib/features/flowedit.js",
    "./feature/trace": "./lib/features/trace.js",
    "./feature/http": "./lib/features/http.js",
    "./feature/ports": "./lib/features/ports.js",
    "./feature/calc": "./lib/features/calc.js",
    "./feature/usage": "./lib/features/usage.js",
    "./feature/prompt": "./lib/features/prompt.js",
    "./feature/context": "./lib/features/context.js",
    "./feature/aiassist": "./lib/features/aiassist.js",
    "./feature/tools": "./lib/features/tools.js",
    "./feature/search": "./lib/features/search.js",
    "./feature/lineage": "./lib/features/lineage.js",
    "./feature/aiusage": "./lib/features/aiusage.js",
    "./feature/quota": "./lib/features/quota.js",
    "./feature/selfview": "./lib/features/selfview.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Iwctwbh/dsh-flowglass.git"
  },
  "license": "MIT",
  "author": "Iwctwbh",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "toolbox",
    "dynamic-toolbox"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "files": [
    "lib/**",
    "manifest.json",
    "BUILDINFO.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.1 || ^0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1 || ^0.1.6-alpha.2",
    "react": "^18.3.1"
  }
}
